# Full iframe URL of the hosted FAQ bot (including its token). Unset = fallback card.
VITE_FAQBOT_URL=
# Enquiry form: Google Apps Script web app URL (see docs/enquiry-apps-script.gs). Unset = mailto fallback.
VITE_ENQUIRY_ENDPOINT=
# Cloudflare Turnstile site key (public). Unset = no spam check (dev only).
VITE_TURNSTILE_SITE_KEY=
# Optional analytics, loaded only after the visitor accepts cookies.
VITE_GA_ID=
VITE_META_PIXEL_ID=
