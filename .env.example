# Full iframe URL of the hosted FAQ bot (including its token). Unset = fallback card.
VITE_FAQBOT_URL=
# EmailJS credentials for the enquiry form (public keys). Unset = mailto fallback.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional analytics, loaded only after the visitor accepts cookies.
VITE_GA_ID=
VITE_META_PIXEL_ID=
